{
  "name": "portfolio-public-telemetry-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "PUBLISH_ENABLED": "false", "LIVE_VERIFIED": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "portfolio-public-telemetry-preview", "database_id": "2a7be382-4207-4a7d-bfdd-d3dcdd467584" }],
  "ratelimits": [
    { "name": "READ_LIMIT", "namespace_id": "140101", "simple": { "limit": 30, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "140102", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "invocation_logs": false } },
  "env": {
    "production": {
      "name": "portfolio-public-telemetry",
      "vars": { "PUBLISH_ENABLED": "true", "LIVE_VERIFIED": "false", "ACCEPT_MODE": "observed" },
      "d1_databases": [{ "binding": "DB", "database_name": "portfolio-public-telemetry", "database_id": "bcd833bd-c832-492d-a07d-95a63b71160a" }],
      "ratelimits": [
        { "name": "READ_LIMIT", "namespace_id": "140201", "simple": { "limit": 30, "period": 60 } },
        { "name": "WRITE_LIMIT", "namespace_id": "140202", "simple": { "limit": 6, "period": 60 } }
      ]
    }
  }
}
